# ====================================================
# SafeShare — Production Environment Variables (.env)
# 
# Instructions:
# 1. Copy this file to `.env` on your AWS EC2 server
# 2. Fill in the actual values below
# 3. Run `docker compose up -d --build`
# ====================================================

# Spring Boot Profile
SPRING_PROFILES_ACTIVE=prod

# The public URL of your website (e.g., https://safeshare.yourdomain.com)
APP_BASE_URL=https://safeshare.yourdomain.com
CORS_ALLOWED_ORIGINS=https://safeshare.yourdomain.com

# Database (AWS RDS - MySQL)
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/safeshare?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# Redis (AWS ElastiCache)
REDIS_HOST=
REDIS_PORT=6379

# AWS S3 (File Storage)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# AWS Credentials (If not using EC2 IAM Roles)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# JWT (JSON Web Token) Secret — Make this a long, random string!
JWT_SECRET=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=

# Swagger / OpenAPI (keep false in production)
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
